# Copy to .env and set the certificate password (no quotes or export).
# Local integration testing: allow all frontend origins and connections from other PCs.
CORS_ALLOWED_ORIGINS=*
SERVER_ADDRESS=0.0.0.0
# For deployment, replace * with comma-separated trusted frontend origins.
SERVER_SSL_KEY_STORE_PASSWORD=replace-with-your-certificate-password

# Only uncomment if your Redis differs from localhost:6379 without a password.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
