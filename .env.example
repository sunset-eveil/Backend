# Copy to .env in the project root. Use properties syntax: no quotes or export.
# OS environment variables override this file.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8443
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=file:./certs/local.p12
SERVER_SSL_KEY_STORE_PASSWORD=change-this-local-password

# Exact frontend origins, comma-separated, without trailing slashes.
# Replace/add chrome-extension://YOUR_EXTENSION_ID for your extension.
CORS_ALLOWED_ORIGINS=https://localhost:5173,https://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=5s
REDIS_TIMEOUT=3s
REDIS_SSL_ENABLED=false
